---
// Screen 2 of the ladder — the core: projects as a query result set. The
// section heading is the query (the page's first real h2 — an audit fix),
// each project renders as a full-width result row (whole row = one link,
// gradient border in the product's own color), and the psql-style row count
// footer closes the joke. Studio red never enters a project row.
const projects = [
  {
    name: "ailiste",
    url: "https://ailiste.app",
    domain: "ailiste.app",
    desc: "Cyprus property AI data platform",
    // ailiste's own accent is #5f2b91, the dark end of its choropleth ramp —
    // chosen against a white map, and it disappears against this background.
    // #a978d0 is the middle class of the same ramp: same hue, readable here.
    edge: "from-[#a978d0]/50",
    hoverDomain: "group-hover:text-[#a978d0]",
  },
  {
    name: "troniti",
    url: "https://troniti.com",
    domain: "troniti.com",
    desc: "Non-custodial TRON yield operator",
    edge: "from-[#f7941d]/50",
    hoverDomain: "group-hover:text-[#f7941d]",
  },
  {
    name: "plainai",
    url: "https://plainai.tech",
    domain: "plainai.tech",
    desc: "AI tools directory — honest reviews, news & guides",
    edge: "from-[#93cafa]/50",
    hoverDomain: "group-hover:text-[#93cafa]",
  },
];
---

<section id="projects" class="px-6 py-24 sm:py-32">
  <div class="mx-auto max-w-4xl">
    {/* single line on purpose: Astro collapses whitespace at markup line breaks */}
    <h2 class="mono text-center text-base font-medium text-text sm:text-lg">
      <span class="mr-2 text-text-muted">aaadevs &gt;_</span><span class="text-accent">SELECT</span> * <span class="text-accent">FROM</span> projects <span class="text-accent">WHERE</span> status = <span class="text-green-400">'live'</span>;
    </h2>

    <div class="mt-10 flex flex-col gap-4">
      {
        projects.map((p) => (
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            class={`group rounded-2xl bg-gradient-to-br ${p.edge} via-border to-border p-px`}
          >
            <div class="flex h-full flex-col gap-4 rounded-2xl bg-bg-card p-6 sm:p-7 md:flex-row md:items-center md:gap-6">
              <div class="flex shrink-0 items-center gap-3 md:w-44">
                {p.name === "troniti" ? (
                  <>
                    <svg viewBox="0 0 100 100" class="h-8 w-8 shrink-0" fill="none" aria-hidden="true">
                      <g transform="rotate(-20 50 50)">
                        <ellipse cx="50" cy="50" rx="34" ry="16" fill="none" stroke="#52525b" stroke-width="5" />
                        <circle cx="50" cy="50" r="8.5" fill="#f7941d" />
                        <circle cx="84" cy="50" r="6" fill="#f4f4f5" />
                        <circle cx="16" cy="50" r="6" fill="#f9a63f" />
                      </g>
                    </svg>
                    <span class="text-xl font-semibold tracking-tight text-text sm:text-2xl">troniti</span>
                  </>
                ) : p.name === "plainai" ? (
                  <img src="/images/plainai-logo.svg" alt="plainai" class="h-7 w-auto sm:h-8" />
                ) : (
                  <>
                    {/* ailiste's mark: an area with a part of it measured —
                        kept in sync with Mark.astro in ailiste-app */}
                    <svg viewBox="0 0 24 24" class="h-8 w-8 shrink-0 text-[#a978d0]" fill="none" aria-hidden="true">
                      <path
                        d="M2.4 8.6 L8.6 4 L17.4 4.8 L21.6 11 L16.8 18.4 L6.4 17.6 Z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.4"
                        stroke-linejoin="round"
                      />
                      <path d="M13 4.4 L17.4 4.8 L21.6 11 L16.8 18.4 L11.6 18 Z" fill="currentColor" />
                    </svg>
                    <span class="text-xl font-semibold tracking-tight text-text sm:text-2xl">ailiste</span>
                  </>
                )}
              </div>

              <p class="flex-1 text-text-muted">{p.desc}</p>

              <div class="mono flex shrink-0 items-center gap-4 text-sm">
                <span class="inline-flex items-center gap-1.5 rounded-full border border-green-400/30 bg-green-400/10 px-2.5 py-1 text-xs text-green-400">
                  <span class="h-1.5 w-1.5 rounded-full bg-green-400" />
                  live
                </span>
                {/* md+: fixed right-aligned column so the pills align between rows
                    (domains differ in length); mobile packs the domain right after
                    the pill — fixed width there reads as a stray gap */}
                <span class={`text-text-muted transition-colors md:w-32 md:text-right ${p.hoverDomain}`}>{p.domain} ↗</span>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <p class="mono mt-6 text-center text-sm text-text-muted">(3 rows)</p>
  </div>
</section>
